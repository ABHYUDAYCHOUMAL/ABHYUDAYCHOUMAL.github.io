# Copy to .env.local for machine-specific overrides (gitignored).
# Defaults live in .env.development / .env.production (committed).

# Public site URL (used for canonical links, OG meta, etc.)
VITE_SITE_URL=https://abhyudaychoumal.github.io

# Formspree contact form ID (the path segment in your Formspree endpoint).
# Submissions go to: https://formspree.io/f/<id>
VITE_FORMSPREE_ID=mzbkqogj

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
VITE_GA_ID=

# Ready Player Me avatar URL (.glb). Empty = avatar disabled.
VITE_RPM_AVATAR_URL=
